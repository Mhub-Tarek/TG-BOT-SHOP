# Public refund calculator on the VPS IP.
#
# Install into the existing default HTTP server or as a separate server block:
#   cp /opt/telegram-shop/deploy/nginx-refund-ip.conf.example /etc/nginx/sites-available/telegram-shop-refund
#   ln -s ../sites-available/telegram-shop-refund /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Public link:
#   http://72.60.191.224/refund

server {
    listen 80;
    server_name 72.60.191.224;

    location = /refund {
        proxy_pass http://127.0.0.1:8010/refund;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /refund/ {
        proxy_pass http://127.0.0.1:8010/refund/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
