# =====================  Telegram  =====================
BOT_TOKEN=123456:ABC-DEF...                    # From @BotFather
BOT_USERNAME=Akunding_store_bot                       # Without the @, for referral links
ADMIN_IDS=123456789,987654321                  # Comma-separated Telegram user IDs

# =====================  Branding  =====================
SHOP_NAME=Akunding Store
WELCOME_BLURB=Welcome to Akunding Store — premium digital products at the best prices. Fast, secure, and fully automated delivery.
SUPPORT_USERNAME=YourSupportUser               # Without the @
CHANNEL_URL=https://t.me/yourchannel           # Optional, leave blank to hide
DEFAULT_DELIVERY_PROMISE=💚 Instant Code Delivery\n🛡 Full Year Warranty   # Used in product cards when product.features is empty

# =====================  Binance API  =====================
# Read-only API key is enough. Whitelist your server IP in Binance API restrictions.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# =====================  Payment methods  =====================
# Each method that's configured shows up as a button on checkout.
# Leave any of these blank to hide that button for users.

# 1) Binance Pay (internal Binance UID transfer)
BINANCE_PAY_UID=                              # Your Binance UID, e.g. 1238198801

# 2) USDT on BSC (BEP20)
USDT_BEP20_ADDRESS=                           # Your Binance USDT BEP20 deposit address

# 3) USDT on TRON (TRC20)
USDT_TRC20_ADDRESS=                           # Your Binance USDT TRC20 deposit address

# Common
PAYMENT_TTL_MINUTES=15                         # How long a checkout payment stays valid
POLL_INTERVAL_SECONDS=30                       # How often the auto-poller checks Binance
MIN_DEPOSIT_USDT=1.0

# =====================  Web admin dashboard  =====================
# Bind to loopback and serve through nginx + TLS (see deploy/nginx.conf.example).
# 0.0.0.0 exposes the money panel directly — only do that behind a firewall.
WEB_HOST=127.0.0.1
WEB_PORT=8000
# REQUIRED: the app refuses to start while these are left at the defaults below.
# Generate strong values, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(32))"
WEB_ADMIN_PASSWORD=change-me-now                # CHANGE THIS — login password for the dashboard
WEB_SESSION_SECRET=change-me-too                # CHANGE THIS — random ~32-char session-signing secret
WEB_SECURE_COOKIES=true                         # Secure (HTTPS-only) cookie; set false only for local HTTP dev
WEB_LOGIN_MAX_ATTEMPTS=5                        # Per source IP per WEB_LOGIN_WINDOW_SECONDS
WEB_LOGIN_WINDOW_SECONDS=300
# Trusted reverse-proxy IPs whose X-Forwarded-For is honoured (real client IP
# for the login rate-limiter). Keep as the nginx host.
WEB_FORWARDED_ALLOW_IPS=127.0.0.1

# =====================  Referral  =====================
REFERRAL_PERCENT=5                             # % of referee's deposit credited to referrer (0 to disable)
